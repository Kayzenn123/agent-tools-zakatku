---
import { Font } from 'astro:assets';
import '../styles/zakatku.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>404 — Surat nyasar | ZakatKu</title>
    <meta name="description" content="Halaman tidak ditemukan." />
    <meta name="theme-color" content="#efe8fb" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='6' y='6' width='52' height='52' fill='none' stroke='%23331a5e' stroke-width='5'/%3E%3Ctext x='32' y='42' font-family='sans-serif' font-weight='900' font-size='24' text-anchor='middle' fill='%23331a5e'%3EZK%3C/text%3E%3C/svg%3E" />
    <Font cssVariable="--font-bangers" preload />
    <Font cssVariable="--font-cossette" preload />
    <Font cssVariable="--font-bigshoulders" />
  </head>
  <body>
    <a class="skip" href="#isi">Lompat ke isi</a>
    <main id="isi">
      <div class="wrap" style="padding-block: clamp(3rem, 10vw, 6rem); text-align: center;">
        <p style="font-family:var(--font-accent);font-weight:700;letter-spacing:.22em;font-size:.8rem;color:var(--accent-ink);border:2px solid var(--accent-ink);display:inline-block;padding:.3rem .8rem;transform:rotate(-1.5deg)">Kantor pos zakat</p>
        <h1 style="font-size: clamp(4rem, 18vw, 10rem);">404</h1>
        <p style="font-size:1.2rem;max-width:44ch;margin:1rem auto">Waduh, suratmu nyasar, Bos — alamat ini tidak ada di arsip kami.
          Balik ke meja utama, buku besarnya masih hangat.</p>
        <p><a class="btn btn-primary" href="./">Kembali ke ZakatKu</a></p>
      </div>
    </main>
  </body>
</html>
